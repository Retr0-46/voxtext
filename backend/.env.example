# PostgreSQL and HTTP API
DATABASE_URL=postgres://voxtext:1234@127.0.0.1:5433/voxtext?sslmode=disable
JWT_SECRET=replace_with_a_long_random_secret
HTTP_ADDR=127.0.0.1:8080

# Speech recognition (paths are relative to backend/)
MODELS_DIR=internal/modules/voxtext/models
FFMPEG=ffmpeg
NUM_THREADS=4
DIARIZATION_THRESHOLD=0.8
MIN_DURATION_ON=0.5
MIN_DURATION_OFF=0.5
MAX_UPLOAD_BYTES=524288000
# Empty value uses the operating system's temporary directory.
UPLOAD_TMP_DIR=
